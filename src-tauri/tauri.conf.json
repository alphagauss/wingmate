{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wingmate",
  "version": "0.1.0",
  "identifier": "dev.wingmate.desktop",
  "build": {
    "beforeDevCommand": "pnpm runtime:prepare && pnpm build:frontend",
    "beforeBuildCommand": "pnpm runtime:prepare && pnpm build:frontend",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'", "capabilities": [] }
  },
  "bundle": { "active": false }
}
