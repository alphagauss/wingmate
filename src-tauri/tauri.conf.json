{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wingmate",
  "version": "0.2.0",
  "identifier": "dev.wingmate.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @wingmate/desktop dev",
    "beforeBuildCommand": "pnpm runtime:prepare && pnpm build:frontend",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": [{
        "identifier": "wingmate-home",
        "webviews": ["main", "temporary-*"],
        "permissions": ["allow-home-backend", "allow-window-chrome", "allow-open-connections", "allow-local-share"]
      }, {
        "identifier": "wingmate-connections",
        "webviews": ["wingmate-connections-*"],
        "permissions": ["allow-remote-workbench", "allow-local-share"]
      }]
    }
  },
  "bundle": { "active": false }
}
