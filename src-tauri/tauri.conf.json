{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wingmate",
  "version": "0.1.0",
  "identifier": "dev.wingmate.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm runtime:dev && pnpm build:frontend",
      "wait": true
    },
    "beforeBuildCommand": "pnpm runtime:prepare && pnpm build:frontend",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": [{
        "identifier": "wingmate-home",
        "webviews": ["main"],
        "permissions": ["allow-home-backend"]
      }]
    }
  },
  "bundle": { "active": false }
}
