{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.{cjs,css,html,js,json,jsx,mjs,mts,cts,ts,tsx}",
      "!**/package-lock.json",
      "!!runtime/android/locks",
      "!!runtime/android/patches",
      "!!runtime/patches"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "formatter": {
      "enabled": true,
      "whitespaceSensitivity": "strict"
    }
  }
}
