{
  "name": "wingmate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "tauri": "tauri",
    "runtime:dev": "cargo run --quiet -p wingmate-launcher --no-default-features --bin wingmate-runtime -- prepare-dev",
    "runtime:prepare": "cargo run --quiet -p wingmate-launcher --no-default-features --bin wingmate-runtime -- prepare-build",
    "runtime:android": "node runtime/android/prepare.mjs",
    "dev:stop": "cargo run --quiet -p wingmate-launcher --no-default-features --bin wingmate-runtime -- stop-dev",
    "runtime:benchmark": "node scripts/benchmark-runtime.mjs",
    "dev": "pnpm runtime:dev && pnpm build:frontend && tauri dev",
    "build": "node scripts/build.mjs",
    "build:frontend": "pnpm --filter @wingmate/desktop build",
    "test": "node --test scripts/runtime-files.test.mjs scripts/runtime-patches.test.mjs scripts/runtime-plugins.test.mjs scripts/smoke.test.mjs crates/wingmate-service/src/tunnel/download.test.mjs && pnpm --filter dsh-wingmate-web typecheck && pnpm --filter dsh-wingmate-backends test && pnpm --filter dsh-wingmate-file-viewer test && pnpm build:frontend && cargo test --workspace --no-default-features",
    "test:service": "cargo test -p wingmate-service",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "container-query-polyfill": "1.0.2",
    "css-has-pseudo": "8.0.2",
    "esbuild": "0.27.7",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.1",
    "postcss-value-parser": "4.2.0",
    "tar": "^7.5.7"
  }
}
