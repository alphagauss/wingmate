{
  "name": "wingmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "tauri": "tauri",
    "runtime:dev": "cargo run --quiet -p wingmate-launcher --no-default-features --bin wingmate-runtime -- prepare-dev",
    "runtime:prepare": "cargo run --quiet -p wingmate-launcher --no-default-features --bin wingmate-runtime -- prepare-build",
    "dev:stop": "cargo run --quiet -p wingmate-launcher --no-default-features --bin wingmate-runtime -- stop-dev",
    "runtime:benchmark": "node scripts/benchmark-runtime.mjs",
    "dev": "tauri dev",
    "build": "node scripts/build.mjs",
    "build:frontend": "pnpm --filter @wingmate/desktop build",
    "test": "node --test scripts/runtime-files.test.mjs scripts/runtime-patches.test.mjs scripts/runtime-plugins.test.mjs scripts/smoke.test.mjs && pnpm --filter dsh-wingmate-backends test && pnpm --filter dsh-wingmate-file-viewer test && pnpm build:frontend && cargo test --workspace --no-default-features",
    "test:service": "cargo test -p wingmate-service",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "tar": "^7.5.7"
  }
}
