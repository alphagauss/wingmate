{
  "name": "dsh-wingmate-backends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/host.mjs",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remote-access"
      ]
    }
  },
  "files": ["dist", "cordis.patch.yml", "LICENSE.remote"],
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "2.6.0",
    "@agentclientprotocol/sdk": "2.5.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "esbuild": "0.27.7",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "tsc && node build.mjs",
    "build:client": "tsc && node build.mjs --client-only",
    "test": "npm run build && node --test test/*.test.mjs"
  }
}
