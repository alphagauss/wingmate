{
  "name": "dsh-wingmate-file-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./host.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": ["host.mjs", "dist", "cordis.patch.yml"],
  "scripts": { "build": "node build.mjs", "test": "node build.mjs && node --test test.mjs" },
  "engines": { "dsh": "0.2.2-rc.1" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-documentpreview"]
    }
  },
  "devDependencies": {
    "@file-viewer/web": "3.3.3",
    "@file-viewer/renderer-word": "3.3.3",
    "@file-viewer/renderer-presentation": "3.3.3",
    "@file-viewer/renderer-epub": "3.3.3",
    "@file-viewer/renderer-email": "3.3.3",
    "@file-viewer/renderer-media": "3.3.3",
    "vite": "7.3.1"
  }
}
