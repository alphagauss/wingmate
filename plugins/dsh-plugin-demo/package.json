{
  "name": "dsh-plugin-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "独立运行与 DSH 共用界面和业务的文本统计示例",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24",
    "dsh": "<=0.2.2-rc.5"
  },
  "exports": {
    ".": "./dist/host.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node dist/server.js",
    "prepare": "npm run build",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:plugin": "npm run build && node --test tests/client.test.mjs",
    "dev:dsh": "node scripts/dev-dsh.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "0.27.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.1"
  },
  "license": "MIT"
}
